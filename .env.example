# Copy to .env for local runs. In containers, set these as environment variables / secrets.

APP_ENV=local
LOG_LEVEL=INFO

# --- Postgres ------------------------------------------------------------------
DATABASE_URL=postgresql://app:app@localhost:5432/app
DB_POOL_MAX_SIZE=20
DB_RUN_SETUP_ON_STARTUP=true
# Encrypt checkpoints at rest. Key must be 16, 24 or 32 bytes.
CHECKPOINT_ENCRYPTION=false
# LANGGRAPH_AES_KEY=change-me-to-32-bytes-0123456789

# --- LLMs ("provider:model", see langchain init_chat_model) ----------------------
LLM_SUPERVISOR_MODEL=openai:gpt-5.4-mini
LLM_WORKER_MODEL=openai:gpt-5.4-mini
LLM_SUMMARY_MODEL=openai:gpt-5.4-nano
# LLM_FALLBACK_MODEL=anthropic:claude-sonnet-5-5
OPENAI_API_KEY=sk-...
# Or route everything through your AI gateway (OpenAI-compatible):
# LLM_BASE_URL=https://ai-gateway.internal/v1
# LLM_API_KEY=...

# --- Guardrails ---------------------------------------------------------------------
# JSON list of MCP tool names that need human approval:
# HITL_TOOLS=["list_open_claims"]
PII_SPACY_MODEL=en_core_web_lg
# PII_ENTITIES=["PERSON","PHONE_NUMBER","LOCATION","US_SSN","MEDICAL_LICENSE"]

# --- MCP ---------------------------------------------------------------------------------
MCP_CONFIG_PATH=config/mcp.json

# --- Observability (each part is optional; they combine) ------------------------------------
# OTel: one trace per request across HTTP, agents/LLM (OpenInference), MCP, Postgres.
#    Works with Opik, Langfuse, Phoenix, Arize, Jaeger or your own OTel Collector.
# OTEL_ENABLED=true
# OTEL_SERVICE_NAME=langgraph-starter
# OTEL_CAPTURE_CONTENT=false        # keep false for PII/PHI: no prompts/tool output on spans
#   Opik (Comet cloud):
# OTEL_EXPORTER_OTLP_ENDPOINT=https://www.comet.com/opik/api/v1/private/otel
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=<opik-api-key>,Comet-Workspace=<workspace>,projectName=langgraph-starter
#   Langfuse:
# OTEL_EXPORTER_OTLP_ENDPOINT=https://cloud.langfuse.com/api/public/otel
# OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic <base64(pk:sk)>
#   Your own collector:
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# LangSmith (native SDK, independent of OTel - can run alongside it):
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_...
# LANGSMITH_PROJECT=langgraph-starter
# LANGSMITH_HIDE_INPUTS=true        # PII/PHI: don't send prompts/inputs
# LANGSMITH_HIDE_OUTPUTS=true
# Do NOT set LANGSMITH_TRACING_MODE=otel/hybrid - it breaks span parent links; startup rejects it.
